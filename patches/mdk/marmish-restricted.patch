+//! Maintained Marmish restricted-launch transport, protocol version one.
+use nostr::{Url, util::BoxedFuture};
+use nostr_sdk::{
+    ClientBuilder,
+    pool::{
+        ConnectionMode,
+        transport::{
+            error::TransportError,
+            websocket::{
+                DefaultWebsocketTransport, WebSocketSink, WebSocketStream, WebSocketTransport,
+            },
+        },
+    },
+};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeSet,
+    fs::OpenOptions,
+    io::{self, Read, Write},
+    net::SocketAddr,
+    os::unix::fs::{MetadataExt, OpenOptionsExt},
+    path::PathBuf,
+    sync::OnceLock,
+    time::Duration,
+};
+
+#[derive(Debug)]
+struct Restricted {
+    relays: BTreeSet<String>,
+    proxy: SocketAddr,
+}
+static RESTRICTED: OnceLock<Restricted> = OnceLock::new();
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Config {
+    version: u32,
+    nonce: String,
+    relays: Vec<String>,
+    proxy: SocketAddr,
+}
+#[derive(Serialize)]
+struct Ack<'a> {
+    version: u32,
+    nonce: &'a str,
+    config_sha256: String,
+}
+fn invalid() -> io::Error {
+    io::Error::other("marmish_restricted_config")
+}
+pub fn restricted() -> bool {
+    RESTRICTED.get().is_some()
+}
+
+fn canonical_relay(value: &str) -> io::Result<String> {
+    if !value.is_ascii()
+        || value.bytes().any(|b| b.is_ascii_whitespace() || b < 32)
+        || value.contains([',', '?', '#', '@'])
+    {
+        return Err(invalid());
+    }
+    let url = Url::parse(value).map_err(|_| invalid())?;
+    let authority = value.split_once("://").ok_or_else(invalid)?.1;
+    let (authority, path) = authority.split_once('/').unwrap_or((authority, ""));
+    if !path.is_empty()
+        || authority.ends_with(':')
+        || authority.contains('%')
+        || url.port() == Some(0)
+        || url.scheme() != "wss"
+        || !url.username().is_empty()
+        || url.password().is_some()
+    {
+        return Err(invalid());
+    }
+    let Some(url::Host::Domain(host)) = url.host() else {
+        return Err(invalid());
+    };
+    if host.len() > 253
+        || host.split('.').any(|label| {
+            label.is_empty()
+                || label.len() > 63
+                || !label.as_bytes()[0].is_ascii_alphanumeric()
+                || !label.as_bytes()[label.len() - 1].is_ascii_alphanumeric()
+                || !label
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+        })
+    {
+        return Err(invalid());
+    }
+    Ok(url.to_string())
+}
+
+/// Called before any app client is constructed. macOS artifacts require config.
+pub fn initialize() -> io::Result<()> {
+    let Some(path) = std::env::var_os("MARMISH_RESTRICTED_CONFIG") else {
+        if cfg!(target_os = "macos") {
+            return Err(invalid());
+        }
+        return Ok(());
+    };
+    let path = PathBuf::from(path);
+    #[cfg(target_os = "macos")]
+    let nofollow = 0x100;
+    #[cfg(not(target_os = "macos"))]
+    let nofollow = 0x20000;
+    let mut file = OpenOptions::new()
+        .read(true)
+        .custom_flags(nofollow)
+        .open(&path)?;
+    let meta = file.metadata()?;
+    let parent = path.parent().ok_or_else(invalid)?.metadata()?;
+    if !parent.is_dir()
+        || parent.mode() & 0o777 != 0o700
+        || meta.uid() != parent.uid()
+        || !meta.is_file()
+        || meta.mode() & 0o777 != 0o600
+        || meta.nlink() != 1
+    {
+        return Err(invalid());
+    }
+    let mut bytes = Vec::new();
+    Read::by_ref(&mut file)
+        .take(16385)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > 16384 {
+        return Err(invalid());
+    }
+    let config: Config = serde_json::from_slice(&bytes).map_err(|_| invalid())?;
+    if config.version != 1
+        || config.nonce.len() != 64
+        || !config.nonce.bytes().all(|b| b.is_ascii_hexdigit())
+        || !config.proxy.ip().is_loopback()
+        || !config.proxy.is_ipv4()
+        || config.proxy.port() == 0
+        || !(1..=16).contains(&config.relays.len())
+    {
+        return Err(invalid());
+    }
+    let mut relays = BTreeSet::new();
+    for value in config.relays {
+        if canonical_relay(&value)? != value {
+            return Err(invalid());
+        }
+        relays.insert(value);
+    }
+    RESTRICTED
+        .set(Restricted {
+            relays,
+            proxy: config.proxy,
+        })
+        .map_err(|_| invalid())?;
+    let ack = serde_json::to_vec(&Ack {
+        version: 1,
+        nonce: &config.nonce,
+        config_sha256: format!("{:x}", Sha256::digest(&bytes)),
+    })
+    .map_err(|_| invalid())?;
+    let ack_path = path.with_extension("ack");
+    let mut output = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(ack_path.with_extension("ack.tmp"))?;
+    output.write_all(&ack)?;
+    output.sync_all()?;
+    if ack_path.exists() {
+        return Err(invalid());
+    }
+    std::fs::rename(ack_path.with_extension("ack.tmp"), ack_path)?;
+    Ok(())
+}
+
+pub(crate) fn builder() -> ClientBuilder {
+    let builder = nostr_sdk::Client::builder();
+    if restricted() {
+        builder.websocket_transport(ExactTransport)
+    } else {
+        builder
+    }
+}
+#[derive(Debug)]
+struct ExactTransport;
+impl WebSocketTransport for ExactTransport {
+    fn support_ping(&self) -> bool {
+        true
+    }
+    fn connect<'a>(
+        &'a self,
+        url: &'a Url,
+        _mode: &'a ConnectionMode,
+        limit: Duration,
+    ) -> BoxedFuture<'a, Result<(WebSocketSink, WebSocketStream), TransportError>> {
+        Box::pin(async move {
+            let config = RESTRICTED
+                .get()
+                .ok_or_else(|| TransportError::backend(invalid()))?;
+            if !config.relays.contains(url.as_str()) {
+                return Err(TransportError::backend(invalid()));
+            }
+            let mode = ConnectionMode::Proxy(config.proxy);
+            tokio::time::timeout(limit, DefaultWebsocketTransport.connect(url, &mode, limit))
+                .await
+                .map_err(|_| TransportError::backend(io::Error::other("marmish_connect_timeout")))?
+        })
+    }
+}
