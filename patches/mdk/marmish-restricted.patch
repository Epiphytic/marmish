+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn shared_canonical_relays() {
+        let fixtures: serde_json::Value =
+            serde_json::from_str(include_str!("../marmish-relays.json")).unwrap();
+        for row in fixtures.as_array().unwrap() {
+            let actual = canonical_relay(row["input"].as_str().unwrap()).ok();
+            assert_eq!(actual.as_deref(), row["canonical"].as_str(), "{row}");
+        }
+    }
+
+    #[test]
+    fn initialize_config_and_ack_subprocess() {
+        const MARKER: &str = "MARMISH_CONFIG_TEST_CASE";
+        if let Ok(case) = std::env::var(MARKER) {
+            let path = PathBuf::from(std::env::var_os("MARMISH_RESTRICTED_CONFIG").unwrap());
+            let result = initialize();
+            if case == "good" {
+                result.unwrap();
+                let ack: serde_json::Value =
+                    serde_json::from_slice(&std::fs::read(path.with_extension("ack")).unwrap())
+                        .unwrap();
+                assert_eq!(ack["nonce"], "a".repeat(64));
+                assert_eq!(
+                    ack["config_sha256"],
+                    format!("{:x}", Sha256::digest(std::fs::read(path).unwrap()))
+                );
+            } else {
+                assert!(result.is_err(), "accepted {case}");
+            }
+            return;
+        }
+        use std::os::unix::fs::PermissionsExt;
+        for case in [
+            "good",
+            "existing_ack",
+            "bad_mode",
+            "hardlink",
+            "oversized",
+            "ipv6",
+            "remote_proxy",
+            "noncanonical",
+        ] {
+            let directory =
+                std::env::temp_dir().join(format!("marmish-config-{}-{case}", std::process::id()));
+            std::fs::create_dir(&directory).unwrap();
+            std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o700)).unwrap();
+            let path = directory.join("restricted.json");
+            let mut value = serde_json::json!({"version":1,"nonce":"a".repeat(64),"relays":["wss://selected.example/"],"proxy":"127.0.0.1:12345"});
+            if case == "ipv6" {
+                value["proxy"] = "[::1]:12345".into();
+            }
+            if case == "remote_proxy" {
+                value["proxy"] = "192.0.2.1:12345".into();
+            }
+            if case == "noncanonical" {
+                value["relays"] = serde_json::json!(["wss://selected.example"]);
+            }
+            std::fs::write(
+                &path,
+                if case == "oversized" {
+                    vec![b' '; 16385]
+                } else {
+                    serde_json::to_vec(&value).unwrap()
+                },
+            )
+            .unwrap();
+            std::fs::set_permissions(
+                &path,
+                std::fs::Permissions::from_mode(if case == "bad_mode" { 0o644 } else { 0o600 }),
+            )
+            .unwrap();
+            if case == "hardlink" {
+                std::fs::hard_link(&path, directory.join("linked")).unwrap();
+            }
+            if case == "existing_ack" {
+                std::fs::write(path.with_extension("ack"), b"existing").unwrap();
+            }
+            let status = std::process::Command::new(std::env::current_exe().unwrap())
+                .args([
+                    "--exact",
+                    "marmish_transport::tests::initialize_config_and_ack_subprocess",
+                ])
+                .env(MARKER, case)
+                .env("MARMISH_RESTRICTED_CONFIG", &path)
+                .status()
+                .unwrap();
+            std::fs::remove_dir_all(&directory).unwrap();
+            assert!(status.success(), "{case}");
+        }
+    }
+
+    #[tokio::test]
+    async fn exact_url_before_network_and_total_socks_timeout() {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        RESTRICTED
+            .set(Restricted {
+                relays: BTreeSet::from(["wss://allowed.example/".into()]),
+                proxy: address,
+            })
+            .unwrap();
+        let decoy = Url::parse("wss://decoy.example/").unwrap();
+        assert!(
+            ExactTransport
+                .connect(&decoy, &ConnectionMode::Direct, Duration::from_millis(100))
+                .await
+                .is_err()
+        );
+        listener.set_nonblocking(true).unwrap();
+        assert!(listener.accept().is_err());
+        listener.set_nonblocking(false).unwrap();
+        let task = std::thread::spawn(move || {
+            listener.set_nonblocking(true).unwrap();
+            let deadline = std::time::Instant::now() + Duration::from_secs(2);
+            loop {
+                match listener.accept() {
+                    Ok((stream, _)) => {
+                        std::thread::sleep(Duration::from_millis(400));
+                        drop(stream);
+                        break;
+                    }
+                    Err(e)
+                        if e.kind() == io::ErrorKind::WouldBlock
+                            && std::time::Instant::now() < deadline =>
+                    {
+                        std::thread::sleep(Duration::from_millis(10))
+                    }
+                    Err(e) => panic!("proxy was not used: {e}"),
+                }
+            }
+        });
+        let allowed = Url::parse("wss://allowed.example/").unwrap();
+        let start = std::time::Instant::now();
+        assert!(
+            ExactTransport
+                .connect(
+                    &allowed,
+                    &ConnectionMode::Direct,
+                    Duration::from_millis(100)
+                )
+                .await
+                .is_err()
+        );
+        assert!(start.elapsed() < Duration::from_millis(350));
+        task.join().unwrap();
+    }
+}
